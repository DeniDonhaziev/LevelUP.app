# Скопируйте в .env в корне tracker-mobile и вставьте значения из Firebase Console → Project settings → Your apps.
# https://console.firebase.google.com/

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Push-уведомления чата (как WhatsApp) — Firebase Console → Project settings → Cloud Messaging → Web Push certificates → Generate key pair
EXPO_PUBLIC_FIREBASE_VAPID_KEY=

# Вкладка AI — https://openrouter.ai/keys
EXPO_PUBLIC_OPENROUTER_API_KEY=
# Необязательно: свои модели с openrouter.ai/models
EXPO_PUBLIC_OPENROUTER_MODEL_MAIN=deepseek/deepseek-chat
# EXPO_PUBLIC_OPENROUTER_MODEL_VISION=

# Без интернета / при ECONNRESET: не ходить на expo.dev при старте (npm start / npx expo start)
EXPO_OFFLINE=1
