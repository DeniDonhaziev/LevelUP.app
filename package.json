{
  "name": "tracker-mobile",
  "main": "index.ts",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --offline",
    "start:online": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --offline",
    "web:online": "expo start --web",
    "prepare-pwa": "node scripts/prepare-pwa-assets.cjs",
    "export:web": "npm run prepare-pwa && node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\" && expo export --platform web",
    "deploy:web": "npm run prepare-pwa && npx eas-cli deploy --prod --non-interactive",
    "deploy:web:retry": "powershell -ExecutionPolicy Bypass -File scripts/deploy-web-retry.ps1",
    "deploy:expo": "node scripts/deploy-expo-prod.cjs",
    "deploy:cancel": "node scripts/deploy-cancel-stuck.cjs",
    "build:apk": "node scripts/build-apk.cjs",
    "deploy:fast": "node scripts/deploy-fast.cjs",
    "deploy:hosting": "node scripts/deploy-hosting.cjs",
    "broadcast:push": "node scripts/broadcast-push-cli.cjs",
    "broadcast:push:cloud": "node scripts/broadcast-push.cjs",
    "broadcast:push:local": "node scripts/broadcast-push-local.cjs",
    "sync:clan-push": "node scripts/sync-clan-push-tokens.cjs",
    "deploy:clan-push": "node scripts/deploy-hosting.cjs && npx firebase deploy --only functions --project levelup-ff95c && node scripts/sync-clan-push-tokens.cjs",
    "deploy:levelup": "node scripts/deploy-hosting.cjs && node scripts/broadcast-push-cli.cjs \"LevelUp\" \"Проснись, пора работать\"",
    "setup:push": "node scripts/setup-background-push.cjs",
    "deploy:push": "npm run setup:push && npx firebase deploy --only functions && npm run deploy:web",
    "deploy:functions": "npx firebase deploy --only functions --project levelup-ff95c",
    "deploy:web:preview": "npm run prepare-pwa && npx eas-cli deploy --non-interactive",
    "desktop-shortcut": "powershell -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1",
    "generate-app-icon": "node scripts/generate-app-icon.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "base-64": "^1.0.0",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-sensors": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "firebase": "^11.10.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-android-widget": "^0.20.3",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/base-64": "^1.0.2",
    "@types/react": "~19.1.10",
    "dotenv": "^17.3.1",
    "eas-cli": "^16.32.0",
    "firebase-tools": "^15.20.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "private": true
}
