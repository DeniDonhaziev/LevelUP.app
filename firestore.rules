rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'denidonhaziev@mail.ru';
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /territories/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Логин → email: чтение без авторизации (только get по id, не list)
    // Запись: только владелец uid; без сравнения с token.email — иначе часто permission-denied в Expo
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
    // Общие проекты IT / менеджмент / творчество — видны всем вошедшим
    match /teamProjects/{topicId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.projects is list;
    }
    match /clans/{clanId} {
      allow read: if request.auth != null;
      // Создать клан можно только от своего uid; счётчики/смена владельца — открытая клиентская логика
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null;
      // Удалить клан может только владелец или админ
      allow delete: if request.auth != null && (resource.data.ownerUid == request.auth.uid || isAdmin());
      match /members/{memberId} {
        allow read: if request.auth != null;
        // join/leave/дистанция/передача владения — клиентская логика
        allow write: if request.auth != null;
      }
      match /messages/{messageId} {
        allow read: if request.auth != null;
        // Писать только от своего имени; править/удалять — автор, владелец клана или админ
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update, delete: if request.auth != null
          && (resource.data.uid == request.auth.uid
              || isAdmin()
              || get(/databases/$(database)/documents/clans/$(clanId)).data.ownerUid == request.auth.uid);
      }
    }
    match /clanInvites/{code} {
      // Поиск по одному коду (get) — можно; перечислять все инвайты (list) — нельзя
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if request.auth != null;
    }
    match /runnerStats/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    // Рейтинг велосипедистов — пишет владелец своего документа; админ может удалять любого
    match /cyclistStats/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    match /users/{userId}/pushTokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
